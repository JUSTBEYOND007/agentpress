{
  "name": "agentpress",
  "version": "0.0.0",
  "private": true,
  "description": "Pi Agent driven long-form authoring workspace",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=10.10.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@emnapi/core": "1.11.1",
        "@emnapi/runtime": "1.11.1"
      }
    },
    "patchedDependencies": {
      "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "benchmark:agent": "pnpm --filter @agentpress/demo-kit benchmark",
    "benchmark:editor": "pnpm --filter @agentpress/web benchmark:editor",
    "check": "pnpm check:architecture && pnpm check:file-lengths && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:agent-architecture": "node scripts/check-agent-architecture.mjs",
    "check:dependency-architecture": "depcruise packages apps --config .dependency-cruiser.cjs --output-type err",
    "check:package-surfaces": "node scripts/check-package-surfaces.mjs",
    "check:architecture": "pnpm check:agent-architecture && pnpm check:dependency-architecture && pnpm check:package-surfaces",
    "check:file-lengths": "pnpm --filter @agentpress/web check:file-lengths",
    "demo": "node scripts/demo.mjs",
    "demo:prepare": "node scripts/demo.mjs --prepare-only",
    "local:prepare": "node scripts/demo.mjs --prepare-only",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.agent-model scripts/dev.mjs",
    "eval:online": "pnpm --filter @agentpress/agent-evals eval:online",
    "eval:pr": "pnpm --filter @agentpress/domain test && pnpm --filter @agentpress/tool-runtime test && pnpm --filter @agentpress/agent-runtime test && pnpm --filter @agentpress/agent-application test && pnpm --filter @agentpress/database test && pnpm --filter @agentpress/agent-evals test",
    "eval:rag": "pnpm --filter @agentpress/agent-evals eval:rag",
    "eval:sandbox": "pnpm --filter @agentpress/agent-evals eval:sandbox",
    "eval:skill": "pnpm --filter @agentpress/agent-evals eval:skill",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "docker compose config --quiet",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "24.10.1",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.0",
    "prettier": "3.8.2",
    "publint": "0.3.23",
    "tsx": "4.21.0",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
