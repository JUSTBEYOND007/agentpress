{
  "name": "agentpress",
  "version": "0.0.0",
  "private": true,
  "description": "Pi Agent driven long-form authoring workspace",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=10.10.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@emnapi/core": "1.11.1",
        "@emnapi/runtime": "1.11.1"
      }
    },
    "patchedDependencies": {
      "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "benchmark:agent": "pnpm --filter @agentpress/demo-kit benchmark",
    "benchmark:editor": "pnpm --filter @agentpress/web benchmark:editor",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo": "node scripts/demo.mjs",
    "demo:prepare": "node scripts/demo.mjs --prepare-only",
    "local:prepare": "node scripts/demo.mjs --prepare-only",
    "dev": "turbo run dev --parallel",
    "eval:online": "pnpm --filter @agentpress/agent-evals eval:online",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "docker compose config --quiet",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.8.0",
    "prettier": "3.8.2",
    "tsx": "4.21.0",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
