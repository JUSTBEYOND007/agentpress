{
  "name": "@agentpress/demo-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "benchmark": "node dist/benchmark.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "seed": "node dist/seed.js",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.*' --exclude 'dist/**'",
    "test:integration": "vitest run test/*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentpress/database": "workspace:*",
    "@agentpress/publication-application": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:types"
  }
}
