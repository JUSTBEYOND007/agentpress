{
  "name": "@agentpress/knowledge-retrieval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run --exclude '**/*.integration.test.*' --exclude 'dist/**'",
    "test:integration": "vitest run test/postgres-hybrid-search.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentpress/database": "workspace:*",
    "drizzle-orm": "catalog:"
  }
}
