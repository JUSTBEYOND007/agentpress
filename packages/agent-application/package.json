{
  "name": "@agentpress/agent-application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src test",
    "test": "vitest run --exclude '**/*.integration.test.*' --exclude 'dist/**'",
    "test:integration": "vitest run test/*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentpress/agent-context": "workspace:*",
    "@agentpress/agent-runtime": "workspace:*",
    "@agentpress/contracts": "workspace:*",
    "@agentpress/database": "workspace:*",
    "@agentpress/editor-patch": "workspace:*",
    "@agentpress/tool-runtime": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@sinclair/typebox": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
