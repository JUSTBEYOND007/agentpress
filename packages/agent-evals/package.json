{
  "name": "@agentpress/agent-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@agentpress/agent-application": "workspace:*",
    "@agentpress/agent-runtime": "workspace:*",
    "@agentpress/database": "workspace:*",
    "@agentpress/runtime-tools": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "eval:online": "tsx src/online-cli.ts",
    "lint": "eslint src test",
    "test": "vitest run --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
